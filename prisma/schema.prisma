// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  EMPLOYEE
  MANAGER
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum EmploymentStatus {
  WORKING
  RESIGNED
}

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE
}

enum TableStatus {
  EMPTY
  OCCUPIED
  OUT_OF_SERVICE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

model User {
  id           String     @id @default(uuid()) @map("user_id") @db.Uuid
  username     String     @unique @db.VarChar(50)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  employee     Employee?

  @@map("users")
}

model Employee {
  id               String           @id @default(uuid()) @map("employee_id") @db.Uuid
  employeeCode     String           @unique @map("employee_code") @db.VarChar(20)
  userId           String           @unique @map("user_id") @db.Uuid
  fullName         String           @map("full_name") @db.VarChar(100)
  dateOfBirth      DateTime         @map("date_of_birth") @db.Date
  citizenId        String           @unique @map("citizen_id") @db.Char(12)
  phone            String           @unique @db.VarChar(10)
  employmentStatus EmploymentStatus @default(WORKING) @map("employment_status")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdOrders    Order[]          @relation("CreatedOrders")
  confirmedOrders  Order[]          @relation("ConfirmedOrders")
  servedOrders     Order[]          @relation("ServedOrders")
  payments         Payment[]        @relation("ReceivedPayments")
  invoices         Invoice[]        @relation("IssuedInvoices")

  @@map("employees")
}

model Category {
  id        String    @id @default(uuid()) @map("category_id") @db.Uuid
  name      String    @unique @map("category_name") @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @map("product_id") @db.Uuid
  code        String        @unique @map("product_code") @db.VarChar(20)
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @unique @map("product_name") @db.VarChar(100)
  description String?
  price       Decimal       @db.Decimal(12, 0)
  imageUrl    String?       @map("image_url") @db.VarChar(500)
  status      ProductStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@index([categoryId, status])
  @@map("products")
}

model CafeTable {
  id          String      @id @default(uuid()) @map("table_id") @db.Uuid
  tableNumber Int         @unique @map("table_number")
  capacity    Int
  status      TableStatus @default(EMPTY)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orders      Order[]

  @@map("tables")
}

model Order {
  id                    String        @id @default(uuid()) @map("order_id") @db.Uuid
  code                  String        @unique @map("order_code") @db.VarChar(30)
  orderType             OrderType     @map("order_type")
  tableId               String?       @map("table_id") @db.Uuid
  createdByEmployeeId   String?       @map("created_by_employee_id") @db.Uuid
  confirmedByEmployeeId String?       @map("confirmed_by_employee_id") @db.Uuid
  servedByEmployeeId    String?       @map("served_by_employee_id") @db.Uuid
  status                OrderStatus   @default(PENDING) @map("order_status")
  paymentStatus         PaymentStatus @default(UNPAID) @map("payment_status")
  totalAmount           Decimal       @default(0) @map("total_amount") @db.Decimal(14, 0)
  customerNote          String?       @map("customer_note")
  orderedAt             DateTime      @default(now()) @map("ordered_at")
  confirmedAt           DateTime?     @map("confirmed_at")
  servedAt              DateTime?     @map("served_at")
  completedAt           DateTime?     @map("completed_at")
  cancelledAt           DateTime?     @map("cancelled_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  table                 CafeTable?    @relation(fields: [tableId], references: [id], onDelete: Restrict)
  createdBy             Employee?     @relation("CreatedOrders", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  confirmedBy           Employee?     @relation("ConfirmedOrders", fields: [confirmedByEmployeeId], references: [id], onDelete: Restrict)
  servedBy              Employee?     @relation("ServedOrders", fields: [servedByEmployeeId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  payment               Payment?
  invoice               Invoice?

  @@index([status, paymentStatus])
  @@index([tableId, paymentStatus])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @map("order_item_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(100)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 0)
  note        String?  @db.VarChar(255)
  lineTotal   Decimal  @map("line_total") @db.Decimal(14, 0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid()) @map("payment_id") @db.Uuid
  code                 String        @unique @map("payment_code") @db.VarChar(30)
  orderId              String        @unique @map("order_id") @db.Uuid
  receivedByEmployeeId String        @map("received_by_employee_id") @db.Uuid
  method               PaymentMethod @map("payment_method")
  amount               Decimal       @db.Decimal(14, 0)
  cashReceived         Decimal?      @map("cash_received") @db.Decimal(14, 0)
  changeAmount         Decimal?      @map("change_amount") @db.Decimal(14, 0)
  paidAt               DateTime      @default(now()) @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receivedBy           Employee      @relation("ReceivedPayments", fields: [receivedByEmployeeId], references: [id], onDelete: Restrict)
  invoice              Invoice?

  @@index([paidAt, method])
  @@map("payments")
}

model Invoice {
  id                 String   @id @default(uuid()) @map("invoice_id") @db.Uuid
  code               String   @unique @map("invoice_code") @db.VarChar(30)
  orderId            String   @unique @map("order_id") @db.Uuid
  paymentId          String   @unique @map("payment_id") @db.Uuid
  issuedByEmployeeId String   @map("issued_by_employee_id") @db.Uuid
  totalAmount        Decimal  @map("total_amount") @db.Decimal(14, 0)
  issuedAt           DateTime @default(now()) @map("issued_at")
  pdfUrl             String?  @map("pdf_url") @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at")
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment            Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  issuedBy           Employee @relation("IssuedInvoices", fields: [issuedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([issuedAt])
  @@map("invoices")
}
